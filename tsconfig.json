{
  "compilerOptions": {
    "module" : "ESNext",
    "target" : "ES2022",
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "strict" : false
  },
  "include": [
    "web.root/tq-peanut/application/peanut/**/*.ts",
    "web.root/tq-peanut/pnut/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "bin",
    "web.root/wp-admin",
    "web.root/wp-content",
    "web.root/wp-includes",
    "web.root/**/*.d.ts",
    "wp-block",
    "web.root/tq-peanut/typings/**/*",
    "web.root/tq-peanut/application/assets/js/libraries"
  ],
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority"
  }
}