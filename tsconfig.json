{
  "compilerOptions": {
    "module": "ES6",
    "target" : "ES2019",
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "web.root/tq-peanut/application/peanut/**/*.ts",
    "web.root/tq-peanut/pnut/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "bin",
    "web.root/wp-admin",
    "web.root/wp-content",
    "web.root/wp-includes",
    "web.root/**/*.d.ts",
    // "web.root/tq-peanut/typings",
    "wp-block"
  ],
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority"
  }
}